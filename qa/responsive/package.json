{
  "name": "cinili-saray-responsive-qa",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright Responsive QA for Çinili Saray (isolated from Django deps)",
  "scripts": {
    "qa": "playwright test",
    "qa:mobile": "playwright test --project=phone-390 --project=phone-430",
    "qa:tablet": "playwright test --project=tablet-768 --project=tablet-900",
    "qa:desktop": "playwright test --project=laptop-1366 --project=desktop-1440 --project=desktop-1920",
    "qa:smoke": "QA_SMOKE=1 playwright test --project=phone-390 --project=tablet-768 --project=desktop-1440",
    "qa:sprint2": "QA_SPRINT2=1 playwright test sprint2-shell.spec.js --project=phone-390",
    "qa:sprint5": "QA_SPRINT5=1 playwright test sprint5-roles.spec.js --project=phone-390",
    "qa:report": "playwright show-report reports/html",
    "auth": "playwright test --project=setup",
    "qa:bootstrap-hint": "echo 'Run from repo root: DEBUG=True .venv/bin/python manage.py qa_bootstrap_local'"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "dotenv": "^16.4.7"
  }
}
