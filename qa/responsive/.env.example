# Local Django only (default)
BASE_URL=http://127.0.0.1:8000

# Before first smoke on a stale local SQLite DB:
#   DEBUG=True .venv/bin/python manage.py qa_bootstrap_local
# (applies pending migrations locally + ensures QA user; refuses non-sqlite/non-DEBUG)

# Generic staff (personel / yönetim-capable)
QA_USERNAME=
QA_PASSWORD=

# Optional role-specific overrides
QA_PERSONEL_USERNAME=
QA_PERSONEL_PASSWORD=
QA_OGRETMEN_USERNAME=
QA_OGRETMEN_PASSWORD=
QA_VELI_USERNAME=
QA_VELI_PASSWORD=
QA_TALEBE_USERNAME=
QA_TALEBE_PASSWORD=

# Smoke-only route set (also: npm run qa:smoke)
# QA_SMOKE=1

# Never set unless you knowingly target a remote host
# ALLOW_PROD_QA=1
