DEBUG=True
SECRET_KEY=development-only-secret-key
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
CSRF_TRUSTED_ORIGINS=
# Canlı özel domain (Render Environment):
CUSTOM_DOMAIN=cinilisarayproje.com,www.cinilisarayproje.com
CANONICAL_HOST=cinilisarayproje.com
PANEL_PUBLIC_URL=https://cinilisarayproje.com
# Dijital Duyuru Ekranı alt alan adı (televizyon görüntüleyicisi bu host'un kökünde)
EKRAN_HOST=ekran.cinilisarayproje.com
# E-Kitap alt alan adı (akıllı tahtada deneme kitapçığı). Ana site hesaplarından bağımsızdır.
EKITAP_HOST=ekitap.cinilisarayproje.com
# Yönetici şifresi — yalnızca sunucu ortamına girin (en az 12 karakter önerilir).
EKITAP_YONETICI_SIFRE=
# Canlıda Render kalıcı diskinin alt klasörü; boşsa MEDIA_ROOT/ekitap-medya
# EKITAP_MEDIA_ROOT=/var/ekran-medya/ekitap-medya
# EKITAP_MAKS_PDF_MB=80
# Yerelde: http://ekitap.localhost:8000/
# Ekran medyası (canlıda Render kalıcı diskinin bağlandığı yol).
# Boş bırakılırsa MEDIA_ROOT/ekran-medya kullanılır — yerelde ayar gerekmez.
# EKRAN_MEDIA_ROOT=/var/ekran-medya
# Yerel geliştirmede ek host'lar (varsayılan: ekran.localhost,ekran.127.0.0.1)
# EKRAN_EK_HOSTLAR=ekran.localhost
# WhatsApp / sosyal link önizlemesi (opsiyonel)
# OG_IMAGE_URL=https://cinilisarayproje.com/og.png
# OG_DESCRIPTION=Öğrenmenin En Akıllı Yolu · Çinili Saray Proje
PANEL_NAME=Çinili Saray Proje
PANEL_SHORT=Çinili Saray Proje
PANEL_MOBILE_SHORT=Çinili Saray
PANEL_ORG=Çinili Saray Proje
PANEL_FOOTER=Çinili Saray Proje
SINAV_BASVURU_BASLIK=4A Proje Sınıfı Alım Sınavı
# WhatsApp Cloud API (Meta Business) — başvuru mesajları
WHATSAPP_AKTIF=False
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
AI_ASSISTANT_ENABLED=True
AI_PLATFORM_ENABLED=True
AI_KTT_ANALYSIS_ENABLED=True
# Claude API anahtarı (https://platform.claude.com → API Keys). Yalnızca sunucu ortamına
# (Render → Environment) girin; repoya, tarayıcıya veya loglara yazmayın.
# Boş bırakılırsa analizler ve asistan kural tabanlı modda çalışır.
ANTHROPIC_API_KEY=
# Modeller (varsayılan: claude-opus-5-5). Daha düşük maliyet için claude-sonnet-5-5 yazılabilir.
AI_ANALIZ_MODEL=claude-opus-5-5
AI_SOHBET_MODEL=claude-opus-5-5
# Konu destek soru üretimi / veli mesaj taslağı (tek istekte art arda çok çağrı yapar)
AI_URETIM_MODEL=claude-opus-5-5
# Düşünme derinliği: low | medium | high
AI_ANALIZ_EFFORT=medium
AI_SOHBET_EFFORT=low
AI_URETIM_EFFORT=low
# Maliyet tavanları — tek yanıtta üretilebilecek en fazla token (düşünme dahil)
AI_ANALIZ_MAX_TOKENS=8000
AI_KTT_ANALYSIS_MAX_TOKENS=8000
AI_SOHBET_MAX_TOKENS=3000
# Girdi tavanı (karakter) ve sohbet mesajı uzunluğu
AI_MAX_GIRDI_KARAKTER=120000
AI_SOHBET_MESAJ_MAX_KARAKTER=2000
# Zaman aşımları (saniye) — gunicorn --timeout 90'ın altında kalmalı
AI_ANALIZ_TIMEOUT=75
AI_SOHBET_TIMEOUT=40
AI_SOHBET_TOPLAM_SURE=70
# Kullanıcı başına sınırlar (gunicorn worker başına sayılır)
AI_SOHBET_DAKIKA_LIMIT=10
AI_SOHBET_GUNLUK_LIMIT=150
AI_YENILE_GUNLUK_LIMIT=30
# Analiz önbellek süresi (saat) — aynı analiz bu süre içinde yeniden ücretlendirilmez
AI_CACHE_HOURS=24
# Güvenlik sınıflandırıcısı yanlış ret verirse önerilen yedek modelde otomatik yeniden dene
AI_RET_YEDEK=True
# Web Push (VAPID) — yönetimin "Bildirim Gönder" ekranından telefonlara push
# atabilmesi için. Boşsa özellik sessizce kapalı kalır. Anahtar çifti üretmek
# için: python -c "from py_vapid import Vapid02; import base64; v=Vapid02();
# v.generate_keys(); ..." (bkz. takip/push_bildirim_service.py yorumları)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=
# Canlı duyuru görselleri — Render deploy sonrası silinmesin (Cloudinary ücretsiz):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Responsive QA (qa/responsive) — local only; never commit real passwords
# BASE_URL=http://127.0.0.1:8000
# QA_USERNAME=
# QA_PASSWORD=
# QA_PERSONEL_USERNAME=
# QA_PERSONEL_PASSWORD=
# QA_OGRETMEN_USERNAME=
# QA_OGRETMEN_PASSWORD=
# QA_VELI_USERNAME=
# QA_VELI_PASSWORD=
# QA_TALEBE_USERNAME=
# QA_TALEBE_PASSWORD=
