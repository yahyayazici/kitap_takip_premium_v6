DEBUG=True
SECRET_KEY=development-only-secret-key
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
CSRF_TRUSTED_ORIGINS=
# Canlı özel domain (Render Environment):
CUSTOM_DOMAIN=cinilisarayproje.com,www.cinilisarayproje.com
CANONICAL_HOST=cinilisarayproje.com
PANEL_PUBLIC_URL=https://cinilisarayproje.com
# Dijital Duyuru Ekranı alt alan adı (televizyon görüntüleyicisi bu host'un kökünde)
EKRAN_HOST=ekran.cinilisarayproje.com
# Ekran medyası (canlıda Render kalıcı diskinin bağlandığı yol).
# Boş bırakılırsa MEDIA_ROOT/ekran-medya kullanılır — yerelde ayar gerekmez.
# EKRAN_MEDIA_ROOT=/var/ekran-medya
# Yerel geliştirmede ek host'lar (varsayılan: ekran.localhost,ekran.127.0.0.1)
# EKRAN_EK_HOSTLAR=ekran.localhost
# WhatsApp / sosyal link önizlemesi (opsiyonel)
# OG_IMAGE_URL=https://cinilisarayproje.com/og.png
# OG_DESCRIPTION=Öğrenmenin En Akıllı Yolu · Çinili Saray Proje
PANEL_NAME=Çinili Saray Proje
PANEL_SHORT=Çinili Saray Proje
PANEL_MOBILE_SHORT=Çinili Saray
PANEL_ORG=Çinili Saray Proje
PANEL_FOOTER=Çinili Saray Proje
SINAV_BASVURU_BASLIK=4A Proje Sınıfı Alım Sınavı
# WhatsApp Cloud API (Meta Business) — başvuru mesajları
WHATSAPP_AKTIF=False
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
AI_ASSISTANT_ENABLED=True
AI_PLATFORM_ENABLED=True
AI_KTT_ANALYSIS_ENABLED=True
# OpenAI API key — Render Environment'a ekleyin (canlı yapay zeka analizleri için zorunlu)
OPENAI_API_KEY=
AI_ASSISTANT_MODEL=gpt-4o-mini
AI_PLATFORM_MAX_TOKENS=2000
# Web Push (VAPID) — yönetimin "Bildirim Gönder" ekranından telefonlara push
# atabilmesi için. Boşsa özellik sessizce kapalı kalır. Anahtar çifti üretmek
# için: python -c "from py_vapid import Vapid02; import base64; v=Vapid02();
# v.generate_keys(); ..." (bkz. takip/push_bildirim_service.py yorumları)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=
# Canlı duyuru görselleri — Render deploy sonrası silinmesin (Cloudinary ücretsiz):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Responsive QA (qa/responsive) — local only; never commit real passwords
# BASE_URL=http://127.0.0.1:8000
# QA_USERNAME=
# QA_PASSWORD=
# QA_PERSONEL_USERNAME=
# QA_PERSONEL_PASSWORD=
# QA_OGRETMEN_USERNAME=
# QA_OGRETMEN_PASSWORD=
# QA_VELI_USERNAME=
# QA_VELI_PASSWORD=
# QA_TALEBE_USERNAME=
# QA_TALEBE_PASSWORD=
